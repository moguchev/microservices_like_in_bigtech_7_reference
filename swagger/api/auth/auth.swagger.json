{
  "swagger": "2.0",
  "info": {
    "title": "AuthService",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "AuthService"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/login": {
      "post": {
        "summary": "Вход по email/паролю и выдача токенов",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Запрос на вход",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/refresh": {
      "post": {
        "summary": "Обновление токенов",
        "operationId": "AuthService_Refresh",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RefreshResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Запрос RefreshToken",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/register": {
      "post": {
        "summary": "Регистрация по email/паролю",
        "operationId": "AuthService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RegisterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Запрос на регистрацию",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RegisterRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "user@gmail.com",
          "description": "email пользователя",
          "title": "email"
        },
        "password": {
          "type": "string",
          "example": "xQta78",
          "description": "пароль",
          "title": "password"
        }
      },
      "description": "Запрос на вход",
      "title": "LoginRequest",
      "required": [
        "email",
        "password"
      ]
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Access токен",
          "title": "access_token"
        },
        "refresh_token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Refresh токен",
          "title": "refresh_token"
        },
        "user_id": {
          "type": "string",
          "example": "123e4567-e89b-12d3-a456-426614174000",
          "description": "Id пользователя",
          "title": "user_id"
        }
      },
      "description": "LoginResponse - ответ Login",
      "title": "LoginResponse"
    },
    "v1RefreshRequest": {
      "type": "object",
      "properties": {
        "refresh_token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Refresh токен",
          "title": "refresh_token"
        }
      },
      "description": "Запрос RefreshToken",
      "title": "RefreshTokenRequest",
      "required": [
        "refresh_token"
      ]
    },
    "v1RefreshResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Access токен",
          "title": "access_token"
        },
        "refresh_token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "description": "Refresh токен",
          "title": "refresh_token"
        },
        "user_id": {
          "type": "string",
          "example": "123e4567-e89b-12d3-a456-426614174000",
          "description": "Id пользователя",
          "title": "user_id"
        }
      },
      "description": "RefreshResponse - ответ Refresh",
      "title": "RefreshResponse"
    },
    "v1RegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "user@gmail.com",
          "description": "email пользователя",
          "title": "email"
        },
        "password": {
          "type": "string",
          "example": "xQta78",
          "description": "пароль",
          "title": "password"
        }
      },
      "description": "Запрос на регистрацию",
      "title": "RegisterRequest",
      "required": [
        "email",
        "password"
      ]
    },
    "v1RegisterResponse": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "example": "123e4567-e89b-12d3-a456-426614174000",
          "description": "Id пользователя",
          "title": "user_id"
        }
      },
      "description": "RegisterResponse - ответ Register",
      "title": "RegisterResponse"
    }
  }
}
