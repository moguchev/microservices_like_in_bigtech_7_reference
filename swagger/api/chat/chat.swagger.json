                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1StreamMessagesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Запрос на получение потока сообщений",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1StreamMessagesRequest"
            }
          }
        ],
        "tags": [
          "ChatService"
        ],
        "deprecated": true
      }
